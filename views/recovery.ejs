<%- include('partials/header',{title}) %><section class="page-intro"><div><span class="eyebrow">FLEXIBLE, NOT PERFECT</span><h2>Small steps for today</h2><p class="muted">A gentle plan based on your latest check-in. Keep only what feels useful.</p></div><span class="tag">Personalized reflection</span></section><% if(saved){ %><div class="success-banner">Your check-in has been saved. Here are possible next steps.</div><% } %><div class="grid recovery-grid"><section class="panel"><div class="panel-heading"><div><h3>Suggested actions</h3><p class="muted">Choose one. You don't need to do everything.</p></div></div><% suggestions.forEach((a,i)=>{ %><div class="suggestion"><span class="suggestion-num">0<%= i+1 %></span><div><strong><%= a[0] %></strong><p><%= a[1] %></p></div></div><% }) %><form method="post" action="/recovery/add" class="add-action-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="title" value="<%= suggestions[0][0] %>"><input type="hidden" name="description" value="<%= suggestions[0][1] %>"><button class="btn btn-primary">＋ Add first suggestion to my plan</button></form></section><section class="panel"><div class="panel-heading"><div><h3>Today's plan</h3><p class="muted">Your chosen actions</p></div></div><% if(!actions.length){ %><div class="empty-state compact"><div class="empty-icon">✦</div><strong>Your plan is waiting</strong><p>Add a suggested action to begin.</p></div><% }actions.forEach(a=>{ %><div class="saved-action"><div><strong><%= a.title %></strong><p><%= a.description %></p><span class="status <%= a.status %>"><%= a.status %></span></div><% if(a.status==='suggested'){ %><div class="action-links"><% ['done','skipped'].forEach(s=>{ %><form method="post" action="/recovery/<%= a._id %>/<%= s %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button><%= s==='done'?'Done':'Skip' %></button></form><% }) %></div><% } %></div><% }) %></section></div><div class="disclaimer">These are general well-being ideas, not a treatment plan. Adapt or skip them to suit your circumstances.</div><%- include('partials/footer') %>
