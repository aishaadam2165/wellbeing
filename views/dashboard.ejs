<%- include('partials/header',{title}) %><section class="welcome-row"><div><div class="eyebrow">A LITTLE PROGRESS, EVERY DAY</div><h2>Welcome back, <%= firstName %> <span class="wave">✦</span></h2><p class="muted">Your well-being is not a competition. Let's see how you're doing today.</p></div><a class="btn btn-primary" href="/checkin">＋ Daily check-in</a></section><div class="grid stats-grid"><article class="stat-card"><div class="stat-top"><span>Latest mood</span></div><strong><%= latest?latest.mood+'/5':'—' %></strong><small><%= latest?'From your latest check-in':'Add your first check-in' %></small></article><article class="stat-card"><div class="stat-top"><span>Average mood</span></div><strong><%= avg?avg+'/5':'—' %></strong><small>Based on last <%= checks.length %> check-ins</small></article><article class="stat-card"><div class="stat-top"><span>Sleep last check-in</span></div><strong><%= latest?latest.sleepHours+'h':'—' %></strong><small>Self-reported sleep</small></article><article class="stat-card"><div class="stat-top"><span>Recent check-ins</span></div><strong><%= checks.length %></strong><small>Entries in this overview</small></article></div><div class="grid content-grid"><section class="panel chart-panel"><div class="panel-heading"><div><h3>Your mood journey</h3><p class="muted">Your recent self-reported check-ins</p></div><span class="tag">Last 7 entries</span></div><% if(checks.length){ %><div class="chart-wrap"><canvas id="moodChart" aria-label="Mood trend chart"></canvas></div><script>window.moodData=<%- JSON.stringify(checks.slice().reverse().map(c=>({label:new Date(c.createdAt).toLocaleDateString('en',{month:'short',day:'numeric'}),value:c.mood}))) %>;</script><% }else{ %><div class="empty-state"><div class="empty-icon">♡</div><strong>Your journey starts here</strong><p>Add a check-in to begin noticing your own patterns.</p><a href="/checkin" class="text-link">Create first check-in →</a></div><% } %></section><section class="panel insight-panel"><div class="panel-heading"><div><h3>Behavioural insight</h3><p class="muted">A gentle reflection, not a diagnosis</p></div></div><p class="insight-copy"><%= latest?insight:'Once you add a check-in, we will offer gentle reflections based on your own entries.' %></p><small class="muted">Based only on your entries. This is not a clinical prediction.</small><p><a class="text-link" href="/checkin">Update how you're feeling →</a></p></section></div><section class="panel quick-panel"><div class="panel-heading"><div><h3>Your next small step</h3><p class="muted">Choose something realistic for today.</p></div></div><div class="quick-actions"><a href="/recovery" class="quick-action"><span class="quick-icon mint">☀</span><span><strong>View recovery plan</strong><small>Build a gentle, flexible routine</small></span><b>→</b></a><a href="/assistant" class="quick-action"><span class="quick-icon lilac">✦</span><span><strong>Talk to the AI assistant</strong><small>Ask a health or well-being question</small></span><b>→</b></a></div></section><%- include('partials/footer') %>
