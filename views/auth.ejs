<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · WellSpring AI</title><link rel="stylesheet" href="/assets/style.css"></head><body class="auth-page"><div class="auth-card"><a class="brand auth-brand" href="/login"><span class="brand-mark">W</span><span>WellSpring<span class="brand-ai"> AI</span></span></a><div class="eyebrow"><%= register?'YOUR PERSONAL WELL-BEING SPACE':'WELCOME BACK' %></div><h1><%= register?'Create your account':'Sign in to your space' %></h1><p class="muted"><%= register?'Start with small check-ins. Your progress belongs to you.':'A calmer way to understand your patterns.' %></p><% if(error){ %><div class="alert"><%= error %></div><% } %><form method="post" class="form-stack" action="<%= register?'/register':'/login' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(register){ %><label>Your name<input name="name" required maxlength="100" autocomplete="name"></label><% } %><label>Email address<input name="email" type="email" required autocomplete="email"></label><label>Password<input name="password" type="password" minlength="8" required autocomplete="<%= register?'new-password':'current-password' %>"></label><button class="btn btn-primary full"><%= register?'Create account':'Sign in' %></button></form><p class="auth-switch"><%= register?'Already have an account?':'New here?' %> <a href="<%= register?'/login':'/register' %>"><%= register?'Sign in':'Create an account' %></a></p><p class="tiny muted">Prototype only. Do not enter data you would not want stored in this application.</p></div></body></html>
