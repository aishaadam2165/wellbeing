<%- include('partials/header',{title}) %><section class="page-intro"><div><span class="eyebrow">TAKE A MOMENT FOR YOURSELF</span><h2>How are you feeling today?</h2><p class="muted">There are no right or wrong answers. This is just a snapshot of your day.</p></div></section><% if(error){ %><div class="alert"><%= error %></div><% } %><form method="post" class="panel checkin-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-section"><h3>Emotional check-in</h3><p class="muted">How would you rate your mood today?</p><div class="rating-options"><% ['Very low','Low','Okay','Good','Great'].forEach((x,i)=>{ %><label class="rating-option"><input type="radio" name="mood" value="<%= i+1 %>" required><span class="rating-number"><%= i+1 %></span><span><%= x %></span></label><% }) %></div></div><div class="form-grid"><label>Energy level <span class="hint">1 = very low · 5 = high</span><select name="energy" required><option value="">Choose…</option><% for(let i=1;i<=5;i++){ %><option value="<%= i %>"><%= i %></option><% } %></select></label><label>Stress level <span class="hint">1 = calm · 5 = very high</span><select name="stress" required><option value="">Choose…</option><% for(let i=1;i<=5;i++){ %><option value="<%= i %>"><%= i %></option><% } %></select></label><label>Sleep last night (hours)<input name="sleepHours" type="number" min="0" max="24" step="0.5" required></label><label>Movement / activity (minutes)<input name="activityMinutes" type="number" min="0" max="1440" value="0" required></label></div><div class="form-section"><label>Anything you'd like to note? <span class="hint">Optional · up to 500 characters</span><textarea name="note" rows="3" maxlength="500"></textarea></label></div><div class="form-actions"><span class="muted tiny">Saved to your private account.</span><button class="btn btn-primary">Save check-in →</button></div></form><%- include('partials/footer') %>
